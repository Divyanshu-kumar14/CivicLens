FROM python:3.11-slim

WORKDIR /app

COPY agent/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock

COPY agent/ ./agent/
COPY config.yaml ./config.yaml
# Demo worker's classical CV path (agent/demo_worker.py): the torch-free
# vision modules as a real package (cluster.py imports vision.gps). No
# ultralytics/torch anywhere on this import graph, so the image stays lean.
COPY vision/gps.py ./vision/gps.py
COPY vision/classical.py ./vision/classical.py
COPY vision/blur.py ./vision/blur.py
RUN touch ./vision/__init__.py

# Privacy blur needs the Haar XMLs; the opencv wheel ships an empty data dir.
COPY scripts/fetch_cascades.py ./scripts/fetch_cascades.py
RUN python scripts/fetch_cascades.py

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["gunicorn", "agent.main:app", "-w", "2", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--timeout", "300", "--graceful-timeout", "60"]
