FROM node:20-alpine AS build

WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Template (not a plain conf): the entrypoint envsubst fills ADMIN_SECRET for
# the override proxy at container start, keeping the secret out of the bundle.
COPY infra/nginx.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
